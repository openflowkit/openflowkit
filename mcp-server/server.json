{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.openflowkit/openflowkit-mcp",
  "description": "Architecture diagrams for your agent: draw on the live OpenFlowKit canvas or edit diagram files.",
  "repository": {
    "url": "https://github.com/openflowkit/openflowkit",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "openflowkit",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
